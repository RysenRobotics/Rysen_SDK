<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rysen_apexhand</name>
  <version>1.4.6</version>
  <description>ROS2 interface for Rysen ApexHand dexterous hand</description>
  <maintainer email="support@rysen.com">Rysen Team</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>builtin_interfaces</depend>
  <depend>rysen_apexhand_msgs</depend>

  <!-- Optional: used when launch_foxglove_bridge:=true in rysen_apexhand.launch.py -->
  <exec_depend>foxglove_bridge</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
