# Rysen SDK Development Environment
# Based on ROS2 Humble
FROM ros:humble-ros-base

# 设置环境变量
ENV DEBIAN_FRONTEND=noninteractive \
    TZ=Asia/Shanghai \
    ROS_DISTRO=humble

# 配置APT镜像源（使用阿里云镜像加速）
RUN sed -i 's|archive.ubuntu.com|mirrors.aliyun.com|g' /etc/apt/sources.list && \
    sed -i 's|security.ubuntu.com|mirrors.aliyun.com|g' /etc/apt/sources.list

# 更新包列表
RUN apt-get update && apt-get install -y --no-install-recommends \
    # 基础构建工具
    build-essential \
    cmake \
    pkg-config \
    git \
    # 网络通信库
    libboost-all-dev \
    # 串口通信库
    libserialport-dev \
    # 日志和格式化库
    libspdlog-dev \
    libfmt-dev \
    # 配置文件解析库
    libyaml-cpp-dev \
    # 调试工具
    gdb \
    valgrind \
    # URDF 相关库
    liburdfdom-dev \
    liburdfdom-headers-dev \
    # 代码格式化工具
    clang-format \
    # ROS2 开发工具
    python3-colcon-common-extensions \
    python3-rosdep \
    python3-vcstool \
    # Python 包管理工具
    python3-pip \
    ros-humble-foxglove-bridge \
    net-tools \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# 初始化 rosdep（如果需要）
RUN rosdep update || true

# 设置工作目录
WORKDIR /workspace

# 保留源码挂载点
VOLUME ["/workspace"]

# 默认命令
CMD ["/bin/bash"]
