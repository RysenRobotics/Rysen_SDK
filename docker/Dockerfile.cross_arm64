# ==========================================
# 交叉编译环境 (运行在 x86_64 上，编译 ARM64 产物)
# ==========================================
FROM amd64/ubuntu:22.04

# 设置非交互式环境，避免安装时卡住询问时区等问题
ENV DEBIAN_FRONTEND=noninteractive

# 1. 开启多架构支持，允许当前系统安装 ARM64 的库
RUN dpkg --add-architecture arm64

# 2. 修改源列表：
# - 原本的官方源加上 [arch=amd64,i386] 限制，防止拉错架构
# - 追加 ARM64 专用的 ubuntu-ports 软件源
RUN sed -i 's/deb http/deb [arch=amd64,i386] http/g' /etc/apt/sources.list && \
    echo "deb [arch=arm64] http://ports.ubuntu.com/ubuntu-ports jammy main restricted universe multiverse" >> /etc/apt/sources.list && \
    echo "deb [arch=arm64] http://ports.ubuntu.com/ubuntu-ports jammy-updates main restricted universe multiverse" >> /etc/apt/sources.list

# 3. 安装 x86_64 原生的交叉编译工具链和基础工具
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    crossbuild-essential-arm64 \
    cmake \
    pkg-config \
    git \
    wget \
    python3-dev \
    pybind11-dev \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# 4. 安装 ARM64 架构的业务依赖库 (必须带 :arm64 后缀)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libboost-dev:arm64 \
    libboost-system-dev:arm64 \
    libboost-thread-dev:arm64 \
    libboost-filesystem-dev:arm64 \
    libboost-program-options-dev:arm64 \
    libserialport-dev:arm64 \
    libspdlog-dev:arm64 \
    libfmt-dev:arm64 \
    libyaml-cpp-dev:arm64 \
    python3-dev:arm64 \
    liburdfdom-dev:arm64 \
    liburdfdom-headers-dev:arm64 \
    libeigen3-dev:arm64 \
    libtinyxml2-dev:arm64 \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# 设置工作目录
WORKDIR /workspace